# Copia este archivo como .env y completa los valores. El .env NO se sube al repositorio.

# Cadena de conexión de PostgreSQL. En Neon la copias desde el panel ("Connection string").
DATABASE_URL=postgresql://usuario:contrasena@host/basedatos?sslmode=require

# Secreto para firmar los tokens de sesión: cualquier texto largo y aleatorio.
JWT_SECRETO=cambia-esto-por-un-texto-largo-y-aleatorio

# Opcionales
PUERTO=3000
ORIGEN_FRONT=http://localhost:5173
